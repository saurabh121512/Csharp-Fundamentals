### Example

The following basic C# program works with both C# 8 and C# 10:

```csharp
using System;

class Program
{
    static int Add(int a, int b)
    {
        return a + b;
    }

    static void Main()
    {
        int age = 21;
        string name = "Saurabh";
        bool isLearning = true;

        int sum = Add(10, 20);

        for (int i = 1; i <= 5; i++)
        {
            Console.WriteLine(i);
        }

        Console.WriteLine($"Name: {name}");
        Console.WriteLine($"Age: {age}");
        Console.WriteLine($"Sum: {sum}");
        Console.WriteLine($"Learning C#: {isLearning}");
    }
}


